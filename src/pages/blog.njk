---
layout: base
title: Blog
description: 'Posts and notes.'
pagination:
  data: collections.nonPinnedPosts
  size: 10
permalink: 'blog/{% if pagination.pageNumber >=1 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html'
---

<div class="blog-page">
  <header class="blog-page__header">
    <h1 class="blog-page__title">{{ title }}</h1>
  </header>

  <!-- Tag Filter -->
  <div class="blog-filter">
    <button class="blog-filter-btn active" data-filter="all">All</button>
    {% set allTags = [] %}
    {%- for post in collections.allPosts -%}
      {%- for tag in post.data.tags -%}
        {%- if tag and tag != 'posts' and tag not in allTags -%}
          {% set allTags = (allTags.push(tag), allTags) %}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- for tag in allTags | sort -%}
      <button class="blog-filter-btn" data-filter="{{ tag }}">{{ tag | capitalize }}</button>
    {%- endfor -%}
  </div>

  <div class="blog-list">
    {% set currentYear = 0 %}
    {% set currentFilteredYear = 0 %}

    {%- for post in pagination.items -%}
      {% set year = post.date.getFullYear() %}
      {% set postTags = post.data.tags | join(' ') %}

      {% if year != currentFilteredYear %}
        <span class="blog-year" data-year="{{ year }}">{{ year }}</span>
        {% set currentFilteredYear = year %}
      {% endif %}

      <article class="blog-list-item" data-tags="{{ postTags }}" data-year="{{ year }}" data-page="current">
        <a href="{{ post.url }}" class="blog-row">
          <time class="blog-row__date" datetime="{{ post.date }}">{{ post.date | formatDate('MMM D, YYYY') }}</time>
          <span class="blog-row__title">{{ post.data.title }}</span>
          <span class="blog-row__tags">
            {% for tag in post.data.tags %}{% if tag != "posts" %}{{ tag }}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
          </span>
        </a>
      </article>
    {%- endfor -%}

    <!-- Hidden posts for filtering (all other posts not on current page) -->
    {%- for post in collections.nonPinnedPosts -%}
      {%- set isOnCurrentPage = false -%}
      {%- for pagePost in pagination.items -%}
        {%- if pagePost.url == post.url -%}
          {%- set isOnCurrentPage = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if not isOnCurrentPage -%}
        {% set year = post.date.getFullYear() %}
        {% set postTags = post.data.tags | join(' ') %}

        <article class="blog-list-item" data-tags="{{ postTags }}" data-year="{{ year }}" data-page="other" style="display: none;">
          <span class="blog-year" data-year="{{ year }}" style="display: none;">{{ year }}</span>
          <a href="{{ post.url }}" class="blog-row">
            <time class="blog-row__date" datetime="{{ post.date }}">{{ post.date | formatDate('MMM D, YYYY') }}</time>
            <span class="blog-row__title">{{ post.data.title }}</span>
            <span class="blog-row__tags">
              {% for tag in post.data.tags %}{% if tag != "posts" %}{{ tag }}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
            </span>
          </a>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- Pagination (shown only when "All" filter active) -->
  {% set collectionToPaginate = collections.nonPinnedPosts %}
  {% set metaKey = "blog" %}
  {% if collectionToPaginate.length > pagination.size %}
    <div class="pagination-container">
      {% include 'partials/pagination.njk' %}
    </div>
  {% endif %}
</div>

<script>
  // Blog tag filtering
  (function() {
    const filterBtns = document.querySelectorAll('.blog-filter-btn');
    const blogItems = document.querySelectorAll('.blog-list-item');
    const yearHeaders = document.querySelectorAll('.blog-year');
    const paginationContainer = document.querySelector('.pagination-container');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const filter = this.getAttribute('data-filter');

        filterBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        blogItems.forEach(item => {
          const isCurrentPage = item.getAttribute('data-page') === 'current';
          const itemTags = item.getAttribute('data-tags') || '';

          if (filter === 'all') {
            if (isCurrentPage) {
              item.style.display = '';
              item.classList.remove('filtered-out');
            } else {
              item.style.display = 'none';
              item.classList.add('filtered-out');
            }
          } else {
            if (itemTags.includes(filter)) {
              item.style.display = '';
              item.classList.remove('filtered-out');
            } else {
              item.style.display = 'none';
              item.classList.add('filtered-out');
            }
          }
        });

        if (paginationContainer) {
          paginationContainer.style.display = filter === 'all' ? '' : 'none';
        }

        updateYearHeaders();
      });
    });

    function updateYearHeaders() {
      const visibleYears = new Map();

      blogItems.forEach(item => {
        if (item.style.display !== 'none') {
          const year = item.getAttribute('data-year');
          if (!visibleYears.has(year)) {
            visibleYears.set(year, true);
          }
        }
      });

      const processedYears = new Set();
      yearHeaders.forEach(header => {
        const year = header.getAttribute('data-year');

        if (visibleYears.has(year) && !processedYears.has(year)) {
          header.style.display = '';
          processedYears.add(year);
        } else {
          header.style.display = 'none';
        }
      });
    }
  })();
</script>

{%- css "local" -%}
  {%- include 'css/blog-list.css' -%}
{%- endcss -%}
