---
layout: base
permalink: /index.html
title: 'the lizards den'
description: 'Lizards Den, a creative notebook'
blog:
  title: 'Posts'
---

<div class="home-page">
  <section class="hero">
    <span class="hero__label">// 001 creative_notebook.md</span>
    <h1 class="hero__title">the lizards den</h1>
    <p class="hero__subtitle">A personal workshop for creative ramblings — Houdini, Unity, Blender and more.</p>
  </section>

  <section class="home-posts">
    <span class="home-posts__label">Recent writing</span>
    <ul class="post-rows" role="list">
      {% set itemList = collections.allPosts %}
      {% for item in itemList.slice(0, 6) %}
        <li class="post-row" style="animation-delay: {{ loop.index0 * 0.04 }}s">
          <a href="{{ item.url }}" class="post-row__link">
            <time class="post-row__date" datetime="{{ item.date }}">{{ item.date | formatDate('MMM D, YYYY') }}</time>
            <span class="post-row__title">{{ item.data.title }}</span>
            <span class="post-row__tags">
              {% for tag in item.data.tags %}{% if tag != "posts" %}{{ tag }}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
    <a href="/blog/" class="home-posts__all">All posts &rarr;</a>
  </section>
</div>

{%- css "local" -%}
  .home-page {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0 var(--s3);
  }

  /* Hero */
  .hero {
    padding: var(--s10) 0 var(--s8);
  }

  .hero__label {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s3);
  }

  .hero__title {
    font-size: clamp(52px, 9.5vw, 128px);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0;
    animation: heroReveal 0.6s var(--ease) both;
  }

  .hero__subtitle {
    font-size: 19px;
    font-weight: 300;
    color: var(--text2);
    margin-top: var(--s4);
    max-width: 520px;
    line-height: 1.6;
  }

  /* Post list section */
  .home-posts {
    padding: var(--s7) 0 var(--s9);
    border-top: 1px solid var(--border);
  }

  .home-posts__label {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text3);
    margin-bottom: var(--s4);
  }

  .post-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-row {
    animation: fadeUp 0.3s var(--ease) both;
  }

  .post-row__link {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: var(--s3);
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: opacity 0.15s linear;
  }

  .post-row__link:hover {
    opacity: 0.6;
  }

  .post-row__link:hover .post-row__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .post-row__date {
    font-size: 13px;
    font-weight: 300;
    font-style: italic;
    color: var(--text2);
  }

  .post-row__title {
    font-size: 17px;
    font-weight: 400;
  }

  .post-row__tags {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--text3);
    white-space: nowrap;
  }

  .home-posts__all {
    display: inline-block;
    margin-top: var(--s4);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text2);
    text-decoration: none;
    transition: color 0.15s linear;
  }

  .home-posts__all:hover {
    color: var(--accent);
  }

  /* Mobile */
  @media (max-width: 680px) {
    .hero {
      padding: var(--s7) 0 var(--s6);
    }

    .post-row__link {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .post-row__date {
      order: -1;
    }

    .post-row__tags {
      display: none;
    }
  }
{%- endcss -%}
